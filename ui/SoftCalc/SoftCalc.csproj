<Project Sdk="Microsoft.NET.Sdk">

	<!-- SoftCalc.csproj - SoftCalc desktop UI (WinForms); talks to the Python engine process -->

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>SoftCalc</RootNamespace>
		<AssemblyName>SoftCalc</AssemblyName>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ApplicationIcon>softcalc.ico</ApplicationIcon>
		<Version>1.3.0</Version>
		<Product>SoftCalc</Product>
		<Description>SoftCalc calculator</Description>
		<Copyright>Personal use</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SoftCalc.Tests" />
		<InternalsVisibleTo Include="HelpShots" />
	</ItemGroup>

	<!-- Toolbar icons (IconMCP, MIT: Icons/LICENSE.txt) and the window icon -->
	<ItemGroup>
		<EmbeddedResource Include="Icons\*.svg" LogicalName="icons/%(Filename)%(Extension)" />
		<EmbeddedResource Include="softcalc.ico" LogicalName="softcalc.ico" />
		<EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
	</ItemGroup>

	<!-- Help topics and their pictures (owner 2026-11-10); help/README.md is for authors and stays out -->
	<ItemGroup>
		<EmbeddedResource Include="..\..\help\??-*.md" LogicalName="help/%(Filename)%(Extension)" />
		<EmbeddedResource Include="..\..\help\img\*.png" LogicalName="help/img/%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- ECB rates of the build day, fetched by build/publish.ps1 (-p:RatesSeed=...); used before the first fetch -->
	<ItemGroup Condition="'$(RatesSeed)' != ''">
		<EmbeddedResource Include="$(RatesSeed)" LogicalName="rates-seed.xml" />
	</ItemGroup>

	<!-- M9: the frozen engine, zipped by build/publish.ps1 (-p:EngineZip=...); development builds use engine/.venv -->
	<ItemGroup Condition="'$(EngineZip)' != ''">
		<EmbeddedResource Include="$(EngineZip)" LogicalName="engine.zip" />
	</ItemGroup>

</Project>
